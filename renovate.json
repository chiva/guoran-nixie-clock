{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>chiva/renovate-config",
    "local>chiva/renovate-config:ha-integration"
  ],
  "enabledManagers": [
    "pep621",
    "homeassistant-manifest",
    "github-actions",
    "pre-commit"
  ],
  "packageRules": [
    {
      "description": "Copies of the bluetooth and usb integrations' requirements in the pinned Home Assistant: they move with the harness, by hand, never to their own latest release.",
      "matchPackageNames": [
        "aiousbwatcher",
        "serialx",
        "bleak",
        "bleak-retry-connector",
        "bluetooth-adapters",
        "bluetooth-auto-recovery",
        "bluetooth-data-tools",
        "dbus-fast",
        "habluetooth"
      ],
      "enabled": false
    }
  ]
}
